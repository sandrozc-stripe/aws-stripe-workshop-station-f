# Copy this file to agentcore/.env.local and fill in the real values as you complete the workshop.
# `agentcore dev` reads agentcore/.env.local automatically. This file is a template only —
# .env.local itself is gitignored so your real values never get committed.

# From AWS Console -> Bedrock AgentCore -> Payments -> your Payment Manager (Module 02).
PAYMENT_MANAGER_ARN=

# From the `export ...` lines printed by scripts/setup_payment_user.py (Module 05).
PAYMENT_INSTRUMENT_ID=
PAYMENT_SESSION_ID=
PAYMENT_USER_ID=

# The region where you created the Payment Manager in Module 02 (e.g. us-east-1).
AWS_REGION=

# Explicit AWS credentials for the IAM identity that's allowed to call payment APIs.
# REQUIRED even if you already have a default AWS profile configured locally — if
# `agentcore dev` falls back to a different default profile than the one that owns
# your Payment Manager, payment calls fail with AccessDeniedException on
# GetPaymentInstrument. See Module 08 (Troubleshooting) for details.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
